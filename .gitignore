# Ignore files generated by Python
**/__pycache__
*.pyc

# Ignore log files
*.log

# Ignore system files
.DS_Store

# Ignore compiled Python files
*.pyc

# Ignore environment variables file
.env

# Ignore any data files that are not meant to be version controlled
data/*.csv
data/*.json

# Ignore Airflow files
plugins/
logs/
airflow.cfg

module/
# Local Claude Code settings
.claude/settings.local.json

# Local env backups
.env.backup*
.env.*.backup
