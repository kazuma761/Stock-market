# Copy this file to .env and fill in the values below.
#   cp .env.example .env

# --- Alpha Vantage ---------------------------------------------------------
# The only value you MUST provide. Claim a free key in ~20 seconds at:
#   https://www.alphavantage.co/support/#api-key
ALPHA_API_KEY=

# --- Airflow ---------------------------------------------------------------
# On Linux set this to your user id (`id -u`) so mounted logs stay writable.
# On macOS / Windows the default is fine.
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Postgres --------------------------------------------------------------
# Defaults work as-is; the database is only reachable inside the compose network.
POSTGRES_USER=marketpipe
POSTGRES_PASSWORD=marketpipe
POSTGRES_DB=market_data
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Host port for psql access (container-internal port is always 5432).
POSTGRES_HOST_PORT=5433
